"UnlitGeneric"
{
	// Use the exact stock/PCVR RPG laser texture.  Keeping it in a separate
	// material lets the Quest renderer force ordinary depth testing without
	// changing every other laser1 user in the game.
	"$basetexture" "effects/laser1"
	"$vertexcolor" 1
	"$vertexalpha" 1
	"$additive" 1
	"$nocull" 1
	"$ignorez" 0
}
